etry></mxCell><mxCell id="c1-16" parent="1" value="User types&lt;br/&gt;&quot;show me some chairs under $1000&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="10" y="110" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-17" parent="1" value="POST /api/chat" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="226" as="sourcePoint" /><mxPoint x="435.0" y="226" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-18" parent="1" value="read the session's cart&#10;(grounding, before any model call)" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="292" as="sourcePoint" /><mxPoint x="1035.0" y="292" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-19" parent="1" value="Cart — empty" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="358" as="sourcePoint" /><mxPoint x="435.0" y="358" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-20" parent="1" value="static prompt + 21 tool definitions + the message" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="482" as="sourcePoint" /><mxPoint x="735.0" y="482" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-21" parent="1" value="&quot;call search_products&quot;&#10;{query &quot;chair&quot;, filters {max_price 1000}}" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="548" as="sourcePoint" /><mxPoint x="435.0" y="548" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-22" parent="1" value="Inside our process, in this order&lt;br/&gt;1. tool name to Python function — one dict lookup&lt;br/&gt;2. gates run FIRST — provenance, quantity caps&lt;br/&gt;3. then the backend method is allowed to call out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="604" width="460" height="86" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-23" parent="1" value="GraphQL productProjectionSearch&#10;+ price selection, + locale" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="748" as="sourcePoint" /><mxPoint x="1035.0" y="748" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-24" parent="1" value="5 raw product projections (34 KB)" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="814" as="sourcePoint" /><mxPoint x="435.0" y="814" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-25" parent="1" value="Mapped to typed records&lt;br/&gt;options from attributes that DIFFER across variants&lt;br/&gt;price.discounted.value, not the list price&lt;br/&gt;name from nameAllLocales&lt;br/&gt;then fenced as untrusted data, capped 12k chars" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="870" width="460" height="102" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-26" parent="1" value="same conversation + the fenced product list" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1086" as="sourcePoint" /><mxPoint x="735.0" y="1086" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-27" parent="1" value="&quot;call present_products&quot;&#10;{5 picks, each with a reason}" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="1152" as="sourcePoint" /><mxPoint x="435.0" y="1152" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-28" parent="1" value="Every id checked against what this session saw.&lt;br/&gt;Card filled in from that record. NO commercetools call." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="1208" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-29" parent="1" value="SSE ui event — product cards render" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1324" as="sourcePoint" /><mxPoint x="135.0" y="1324" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-30" parent="1" value="same conversation + result" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1448" as="sourcePoint" /><mxPoint x="735.0" y="1448" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-31" parent="1" value="&quot;call present_suggestions&quot;, then end_turn" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="1514" as="sourcePoint" /><mxPoint x="435.0" y="1514" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-32" parent="1" value="SSE ui + text, then turn_complete&#10;cache_read 31181 — the prompt prefix was reused" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgr