t x="735.0" y="2434" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-14" parent="1" value="commercetools" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="940.0" y="40" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-15" parent="1" value="commercetools" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="940.0" y="2434" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-16" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="90" as="sourcePoint" /><mxPoint x="1035.0" y="2434" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-17" parent="1" value="Operator types&lt;br/&gt;&quot;give me a list of slow selling&lt;br/&gt;products from the past week&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="10" y="110" width="460" height="70" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-18" parent="1" value="POST /api/merchant/chat" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="240" as="sourcePoint" /><mxPoint x="435.0" y="240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-19" parent="1" value="The operator identity comes from server-side config.&lt;br/&gt;No request body ever names an operator or a merchant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="296" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-20" parent="1" value="static prompt + 21 tool definitions + the message" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="470" as="sourcePoint" /><mxPoint x="735.0" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-21" parent="1" value="&quot;call load_skill&quot; {inventory-operations}" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="536" as="sourcePoint" /><mxPoint x="435.0" y="536" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-22" parent="1" value="Read from the in-process skill registry.&lt;br/&gt;Skills are Anthropic's flow files, unchanged. No platform call." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="592" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-23" parent="1" value="same conversation + the skill text" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="766" as="sourcePoint" /><mxPoint x="735.0" y="766" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-24" parent="1" value="&quot;call get_inventory_alerts&quot; {}" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="832" as="sourcePoint" /><mxPoint x="435.0" y="832" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-25" parent="1" value="commercetools has no alerts object.&lt;br/&gt;One tool call becomes four kinds of read." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="888" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-26" parent="1" value="1. inventory where availableQuantity under 10" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1004" as="sourcePoint" /><mxPoint x="1035.0" y="1004" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-27" parent="1" value="candidate SKUs" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1070" as="sourcePoint" /><mxPoint x="435.0" y="1070" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-28" parent="1" value="2. inventory for those SKUs, all supply channels" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1136" as="sourcePoint" /><mxPoint x="1035.0" y="1136" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-29" parent="1" value="per-channel quantities" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1202" as="sourcePoint" /><mxPoint x="435.0" y="1202" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-30" parent="1" value="3. orders from the last 30 days" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1268" as="sourcePoint" /><mxPoint x="1035.0" y="1268" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-31" parent="1" value="order lines, for sales velocity" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1334" as="sourcePoint" /><mxPoint x="435.0" y="1334" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-32" parent="1" value="4. one product lookup per flagged SKU (4 in parallel)" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1400" as="sourcePoint" /><mxPoint x="1035.0" y="1400" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-33" parent="1" value="listings" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1466" as="sourcePoint" /><mxPoint x="435.0" y="1466" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-34" parent="1" value="Alert derived, not read&lt;br/&gt;sellable = the channel-less entry, what the shop can actually sell&lt;br/&gt;other channels reported separately, so nobody reorders stock they own&lt;br/&gt;the result carries a note &quot;the window is 30 days&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="1522" width="460" height="86" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-35" parent="1" value="same conversation + the fenced alerts" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1724" as="sourcePoint" /><mxPoint x="735.0" y="1724" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-36" parent="1" value="&quot;call present_digest&quot; {items}" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="1790" as="sourcePoint" /><mxPoint x="435.0" y="1790" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-37" parent="1" value="SSE ui event — digest card renders" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1856" as="sourcePoint" /><mxPoint x="135.0" y="1856" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-38" parent="1" value="same conversation + result" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1980" as="sourcePoint" /><mxPoint x="735.0" y="1980" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-39" parent="1" value="&quot;call present_suggestions&quot;, then end_turn" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="2046" as="sourcePoint" /><mxPoint x="435.0" y="2046" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-40" parent="1" value="SSE ui + text, then turn_complete" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="2112" as="sourcePoint" /><mxPoint x="135.0" y="2112" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2-41" parent="1" value="The reply corrects the question&lt;br/&gt;&quot;the data covers 30 days, not a week —&lt;br/&gt;no weekly pace is tracked&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="10" y="2168" width="460" height="70" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c2-42" parent="1" value="4 model calls. 8 commercetools calls. 11.5s.&lt;br/&gt;No MCP endpoint." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="10" y="2288" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="d3" name="Merchant write — the approval gate"><mxGraphModel grid="1" gridSize="10" page="1" math="0" shadow="0" dx="1270" dy="1698"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c3-1" parent="1" value="REQUEST 1 — the agent proposes. Nothing is written." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d6b656;" vertex="1"><mxGeometry x="50" y="220" width="1070" height="34" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-2" parent="1" value="REQUEST 2 — a human clicks Approve. Only now is anything written." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5f6ec;strokeColor=#82b366;" vertex="1"><mxGeometry x="50" y="794" width="1070" height="34" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-3" parent="1" value="Browser&#10;(back office)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="40.0" y="40" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-4" parent="1" value="Browser&#10;(back office)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="40.0" y="1498" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-5" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="90" as="sourcePoint" /><mxPoint x="135.0" y="1498" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-6" parent="1" value="Agent&#10;(our process)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="340.0" y="40" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-7" parent="1" value="Agent&#10;(our process)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="340.0" y="1498" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-8" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="90" as="sourcePoint" /><mxPoint x="435.0" y="1498" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-9" parent="1" value="Anthropic&#10;Messages API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="640.0" y="40" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-10" parent="1" value="Anthropic&#10;Messages API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="640.0" y="1498" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-11" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="90" as="sourcePoint" /><mxPoint x="735.0" y="1498" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-12" parent="1" value="commercetools" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="940.0" y="40" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-13" parent="1" value="commercetools" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="940.0" y="1498" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-14" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="90" as="sourcePoint" /><mxPoint x="1035.0" y="1498" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-15" parent="1" value="Operator types&lt;br/&gt;&quot;restock the Classic Serving Tray&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="10" y="110" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-16" parent="1" value="POST /api/merchant/chat" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="284" as="sourcePoint" /><mxPoint x="435.0" y="284" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-17" parent="1" value="static prompt + tools + the message" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="350" as="sourcePoint" /><mxPoint x="735.0" y="350" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-18" parent="1" value="&quot;call stage_inventory_action&quot; {items}" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="416" as="sourcePoint" /><mxPoint x="435.0" y="416" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-19" parent="1" value="read current stock and other-channel units" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="482" as="sourcePoint" /><mxPoint x="1035.0" y="482" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-20" parent="1" value="quantities" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="548" as="sourcePoint" /><mxPoint x="435.0" y="548" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-21" parent="1" value="Guardrails checked at staging&lt;br/&gt;500 units per restock, 25 items per change, 20% per price move&lt;br/&gt;then the proposal is persisted, status = staged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="604" width="460" height="70" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-22" parent="1" value="SSE ui — change preview card&#10;Approve / Dismiss / &quot;Nothing applies until you approve&quot;" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="734" as="sourcePoint" /><mxPoint x="135.0" y="734" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-23" parent="1" value="POST /api/merchant/changes/{id}/apply" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="858" as="sourcePoint" /><mxPoint x="435.0" y="858" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-24" parent="1" value="The approval mark is set for THIS call only&lt;br/&gt;gate — the id must be one this session saw&lt;br/&gt;AND one a human approved&lt;br/&gt;staged status and guardrails re-checked BEFORE the write" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="914" width="460" height="86" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-25" parent="1" value="POST /inventory/{id} addQuantity" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1058" as="sourcePoint" /><mxPoint x="1035.0" y="1058" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-26" parent="1" value="200" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1124" as="sourcePoint" /><mxPoint x="435.0" y="1124" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-27" parent="1" value="Only now marked applied, stamped with who approved it.&lt;br/&gt;The approval mark is cleared, whatever the outcome." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="205.0" y="1180" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c3-28" parent="1" value="{ok true} — the shop's next read sees the new stock" style="endArrow=block;html=1;dashed=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435.0" y="1296" as="sourcePoint" /><mxPoint x="135.0" y="1296" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3-29" parent="1" value="The model can propose. It cannot approve.&lt;br/&gt;Nothing typed in the chat can approve anything." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1"><mxGeometry x="10" y="1352" width="460" height="54" attrib_as="geometry" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>