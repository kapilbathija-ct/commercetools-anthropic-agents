        <mxCell id="c2-32" parent="1" value="4. one product lookup per flagged SKU (4 in parallel)" style="endArrow=block;html=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1">
