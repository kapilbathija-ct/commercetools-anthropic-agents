<mxfile host="app.diagrams.net" type="device"><diagram id="d1" name="Shopping — chairs under $1000"><mxGraphModel grid="1" gridSize="10" page="1" math="0" shadow="0" dx="1270" dy="1996"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1-1" parent="1" value="ROUND 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e9f7;strokeColor=#9db2dc;" vertex="1"><mxGeometry x="60" y="418" width="1050" height="34" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-2" parent="1" value="ROUND 2 — the tool result goes back as a message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e9f7;strokeColor=#9db2dc;" vertex="1"><mxGeometry x="60" y="1022" width="1050" height="34" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-3" parent="1" value="ROUND 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e9f7;strokeColor=#9db2dc;" vertex="1"><mxGeometry x="60" y="1384" width="1050" height="34" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-4" parent="1" value="Browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="40.0" y="40" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-5" parent="1" value="Browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="40.0" y="1796" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-6" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="90" as="sourcePoint" /><mxPoint x="135.0" y="1796" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1-7" parent="1" value="Agent&#10;(our process)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"><mxGeometry x="340.0" y="40" width="190" height="50" attrib_as="geometry" as="geometry" /></mxCell><mxCell id="c1-8" parent="1" valu