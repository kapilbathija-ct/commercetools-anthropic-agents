# commercetools (same variable names as commercetools-es-workspace)
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=
CTP_API_URL=
# Optional: set to create carts in-store (store scoping is creation-time only)
CTP_STORE_KEY=
# Price selection: required, or search returns records with no price data
CT_CURRENCY=USD
CT_COUNTRY=US
CT_LOCALE=en-US
# Anthropic: use an org key here, not a personal one
ANTHROPIC_API_KEY=
# Optional session store; falls back to in-process when unset
REDIS_URL=
# Optional merchant analysis over the order-events warehouse
CT_ANALYSIS_BQ_DATASET=
# commercetools Checkout (PaymentOnly) + the deployed Stripe connector.
# The API client must be created with BOTH manage_project and manage_sessions: the Sessions
# API is a separate grant and commercetools cannot add a scope to an existing client.
CTP_CHECKOUT_APP_KEY=
CTP_CHECKOUT_PROCESSOR_URL=
# Where the agent's checkout card sends the shopper. Must also be in the Checkout
# Application's allowedOrigins, or the payment widget will not load.
STOREFRONT_CHECKOUT_URL=http://localhost:3005/checkout
NEXT_PUBLIC_API_URL=http://localhost:8000
