{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent API (debug, for a walkthrough)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["service.main:app", "--port", "8000", "--log-level", "warning"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYDEVD_DISABLE_FILE_VALIDATION": "1" },

      "justMyCode": false,

      "console": "integratedTerminal",
      "autoReload": { "enable": false }
    }
  ]
}
